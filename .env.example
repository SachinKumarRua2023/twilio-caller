# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_NUMBER=+19292961896

# ── Agents ────────────────────────────────────────────────────────────────────
# Agent 1 (primary / senior) — phone is required
AGENT1_NAME=Sachin
AGENT1_PIN=1234
MY_PHONE_NUMBER=+91xxxxxxxxxx

# Agent 2 (junior) — add phone to enable this agent
AGENT2_NAME=Junior1
AGENT2_PIN=2222
AGENT2_PHONE=+91xxxxxxxxxx

# Agent 3 (junior) — add phone to enable this agent
AGENT3_NAME=Junior2
AGENT3_PIN=3333
AGENT3_PHONE=+91xxxxxxxxxx

# Agent 4 (junior) — optional, leave blank to disable
AGENT4_NAME=Junior3
AGENT4_PIN=4444
AGENT4_PHONE=

# Agent 5 (junior) — optional, leave blank to disable
AGENT5_NAME=Junior4
AGENT5_PIN=5555
AGENT5_PHONE=

# ── Base URL (set this to your Vercel deployment URL) ─────────────────────────
BASE_URL=

# ── Odoo CRM (optional — enables call note logging) ──────────────────────────
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your_db_name
ODOO_USER=your_email@example.com
ODOO_PASS=your_password
